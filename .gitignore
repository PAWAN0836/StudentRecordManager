## .gitignore for C# / .NET projects

# Build output
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docview

# Rider / JetBrains
.idea/
*.DotSettings.user

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
